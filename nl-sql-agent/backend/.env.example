# ── Agent backend ────────────────────────────────────────────
# "ollama"     → local model via Ollama (default)
# "anthropic"  → Anthropic API (requires ANTHROPIC_API_KEY)
AGENT_BACKEND=ollama

# ── Ollama (used when AGENT_BACKEND=ollama) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Anthropic (used when AGENT_BACKEND=anthropic) ─────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Database (use the read-only user for the agent) ───────────
DATABASE_URL=postgresql://nl_agent_ro:change_me_in_env@localhost:5432/nl_agent_db

# ── Agent config ──────────────────────────────────────────────
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=10
ALLOWED_SCHEMAS=public

# ── FastAPI ───────────────────────────────────────────────────
API_PORT=8000
CORS_ORIGIN=http://localhost:3000
