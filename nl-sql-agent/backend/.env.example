# ── LLM ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Database ──────────────────────────────────────────────────
# Point this at any PostgreSQL database — the agent reads the
# schema automatically on startup and works with whatever it finds.
DATABASE_URL=postgresql://readonly_user:password@host:5432/your_database

# ── Tuning ────────────────────────────────────────────────────
MAX_ROWS=50
QUERY_TIMEOUT_SECONDS=10
ALLOWED_SCHEMAS=public

# ── FastAPI ───────────────────────────────────────────────────
API_PORT=8000
CORS_ORIGIN=http://localhost:3000
